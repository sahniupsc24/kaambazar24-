# Frontend Environment Configuration for Production (Vercel)

# Supabase Credentials (Required for Auth & Database)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Production Frontend URL
VITE_SITE_URL=https://your-domain.vercel.app

# Backend API URL (e.g., deployed on Railway or Render)
VITE_API_URL=https://your-backend-project.up.railway.app/api

# Optional: Razorpay Key ID
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_here

