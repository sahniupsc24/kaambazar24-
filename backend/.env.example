NODE_ENV=development
PORT=4000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=workforce_marketplace

JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:3000

# First-run admin seed (used only by `npm run seed`, then change the password)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!

# Payment gateway (Razorpay) keys are NOT set here — they are entered by
# Admin at runtime via Admin Dashboard > Payment Gateway, stored in the
# payment_gateway_settings table. No redeploy needed to change them.

# SMS/OTP gateway is not wired yet — OtpService currently logs codes to
# the server console (see backend/src/services/OtpService.ts). Plug in a
# real provider (MSG91, Twilio, etc.) there when one is chosen.
