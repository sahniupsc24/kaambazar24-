# Backend Environment Configuration for Production

NODE_ENV=production
PORT=4000
# IMPORTANT: Update this to your exact Vercel frontend URL so CORS allows it
FRONTEND_URL=https://your-frontend-project.vercel.app

# Database (Railway provides this automatically)
DATABASE_URL=postgresql://user:password@host:port/database

# Security Secrets (Must be changed to random strong strings!)
JWT_SECRET=my_super_secret_jwt_key_that_is_very_long_and_random

# Payment Gateway (Razorpay Live Keys)
RAZORPAY_KEY_ID=your_razorpay_live_key_id
RAZORPAY_KEY_SECRET=your_razorpay_live_key_secret

# Default Admin Credentials (Used to seed the first admin on startup)
ADMIN_EMAIL=admin@kaambazar.com
ADMIN_PASSWORD=SuperSecurePassword123!
